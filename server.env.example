# Frontend — serverdagi .env (GitHub ga yuklanmaydi). Nusxa:  cp server.env.example .env

# Hozircha domen/SSL yo‘q: oddiy nginx, sayt http://173.249.39.129 orqali.
# Domen ishlagach shu qatorni o‘chiring va CERTBOT_EMAIL ni yozing — SSL avtomatik yoqiladi.
COMPOSE_FILE=docker-compose.yml:docker-compose.http.yml

# Let's Encrypt shu manzilga sertifikat muddati haqida xabar yuboradi
CERTBOT_EMAIL=
# 1 = test serveri (birinchi sinov uchun), 0 = haqiqiy sertifikat
CERTBOT_STAGING=0

# backend .env dagi NEXT_REVALIDATE_SECRET bilan AYNAN bir xil
NEXT_REVALIDATE_SECRET=
