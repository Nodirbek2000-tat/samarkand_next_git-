# Frontend — serverdagi .env (GitHub ga yuklanmaydi). Nusxa:  cp server.env.example .env
# Sayt faqat https://mentadbirkor.uz da ochiladi; SSL sertifikati avtomatik olinadi va har 12 soatda tekshiriladi.

# Let's Encrypt shu manzilga sertifikat muddati haqida xabar yuboradi (majburiy)
CERTBOT_EMAIL=
# 1 = test serveri (birinchi sinov uchun), 0 = haqiqiy sertifikat
CERTBOT_STAGING=0

# backend .env dagi NEXT_REVALIDATE_SECRET bilan AYNAN bir xil
NEXT_REVALIDATE_SECRET=
